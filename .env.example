# QiQ demo SSO. Sign-in happens at the shared login hub (QIQ Demo Login folder,
# https://qiq-demo-login.vercel.app); this demo only needs the shared secret.
# Set in Vercel → Project → Settings → Environment Variables.

# Must be the SAME value as the login hub's SSO_JWT_SECRET.
SSO_JWT_SECRET=change-me

# Optional
SSO_SESSION_HOURS=24
# SSO_HUB_URL=https://qiq-demo-login.vercel.app
